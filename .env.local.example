# Mr. and Mrs Happiness Platform - Environment Variables

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# SendGrid Email Service
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# MongoDB (for local development)
MONGODB_URI=

# Cloud Storage (when configured)
CLOUD_BUCKET_NAME=
CLOUD_REGION=
CLOUD_ACCESS_KEY_ID=
CLOUD_SECRET_ACCESS_KEY=

# Database
DATABASE_URL=

# App Settings
NODE_ENV=
NEXT_PUBLIC_APP_URL=

GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# JWT secret for signing tokens (set a strong random value for production)
NEXTAUTH_SECRET=

# SMTP fallback (fill these if you want nodemailer as fallback)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=